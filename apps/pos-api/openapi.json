{
  "openapi": "3.0.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "AppController_getHello",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "App"
        ]
      }
    },
    "/pos/pair": {
      "post": {
        "operationId": "PairingController_pair",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PairDeviceDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairingResult"
                }
              }
            }
          }
        },
        "tags": [
          "pairing"
        ]
      }
    },
    "/pos/catalog": {
      "get": {
        "operationId": "CatalogController_list",
        "parameters": [
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Match product name, variant SKU, or barcode",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "default": 50,
              "type": "number"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "nextCursor from the previous page",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PosCatalogPage"
                }
              }
            }
          }
        },
        "security": [
          {
            "PosDevice-auth": []
          }
        ],
        "tags": [
          "catalog"
        ]
      }
    },
    "/pos/catalog/scan": {
      "get": {
        "operationId": "CatalogController_scan",
        "parameters": [
          {
            "name": "code",
            "required": true,
            "in": "query",
            "description": "A scanned barcode or a variant SKU",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PosScanResult"
                }
              }
            }
          }
        },
        "security": [
          {
            "PosDevice-auth": []
          }
        ],
        "tags": [
          "catalog"
        ]
      }
    },
    "/pos/catalog/{id}": {
      "get": {
        "operationId": "CatalogController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PosCatalogProduct"
                }
              }
            }
          },
          "404": {
            "description": ""
          }
        },
        "security": [
          {
            "PosDevice-auth": []
          }
        ],
        "tags": [
          "catalog"
        ]
      }
    },
    "/pos/session": {
      "get": {
        "operationId": "CatalogController_session",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PosSession"
                }
              }
            }
          }
        },
        "security": [
          {
            "PosDevice-auth": []
          }
        ],
        "tags": [
          "catalog"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The Health Check is successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "info": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {},
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "The Health Check is not successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "info": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {
                        "redis": {
                          "status": "down",
                          "message": "Could not connect"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        },
                        "redis": {
                          "status": "down",
                          "message": "Could not connect"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Health"
        ]
      }
    }
  },
  "info": {
    "title": "POS",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "PosDevice-auth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-pos-device-token"
      }
    },
    "schemas": {
      "PairDeviceDto": {
        "type": "object",
        "properties": {
          "pairingCode": {
            "type": "string",
            "description": "The pairing code shown in the admin dashboard"
          }
        },
        "required": [
          "pairingCode"
        ]
      },
      "PairingResult": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "accountId": {
            "type": "number"
          },
          "accountName": {
            "type": "string"
          },
          "locationId": {
            "type": "number"
          },
          "locationName": {
            "type": "string"
          },
          "deviceName": {
            "type": "string"
          }
        },
        "required": [
          "token",
          "accountId",
          "accountName",
          "locationId",
          "locationName",
          "deviceName"
        ]
      },
      "PosCatalogBrand": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "PosCatalogCategory": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "PosCatalogImage": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "url": {
            "type": "string"
          },
          "position": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "url",
          "position"
        ]
      },
      "PosCatalogOptionValue": {
        "type": "object",
        "properties": {
          "optionName": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "optionName",
          "value"
        ]
      },
      "PosCatalogVariant": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "sku": {
            "type": "string",
            "nullable": true
          },
          "barcodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "priceCents": {
            "type": "number"
          },
          "stock": {
            "type": "number"
          },
          "optionValues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PosCatalogOptionValue"
            }
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "sku",
          "barcodes",
          "priceCents",
          "stock",
          "optionValues",
          "imageUrl"
        ]
      },
      "PosCatalogProduct": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "brand": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/PosCatalogBrand"
              }
            ]
          },
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PosCatalogCategory"
            }
          },
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PosCatalogImage"
            }
          },
          "variants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PosCatalogVariant"
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "brand",
          "categories",
          "images",
          "variants"
        ]
      },
      "PosCatalogPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PosCatalogProduct"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          },
          "syncedAt": {
            "type": "string"
          }
        },
        "required": [
          "items",
          "nextCursor",
          "syncedAt"
        ]
      },
      "PosScanResult": {
        "type": "object",
        "properties": {
          "product": {
            "$ref": "#/components/schemas/PosCatalogProduct"
          },
          "variantId": {
            "type": "number"
          }
        },
        "required": [
          "product",
          "variantId"
        ]
      },
      "PosSession": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "number"
          },
          "accountName": {
            "type": "string"
          },
          "locationId": {
            "type": "number"
          },
          "locationName": {
            "type": "string"
          },
          "deviceName": {
            "type": "string"
          }
        },
        "required": [
          "accountId",
          "accountName",
          "locationId",
          "locationName",
          "deviceName"
        ]
      }
    }
  }
}