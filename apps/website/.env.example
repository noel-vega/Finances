# Copy to .env. Astro only exposes PUBLIC_-prefixed vars to the client,
# and everything here ships in the static build — so only public values belong.

# Where the "Start selling" / signup CTAs send prospective merchants.
# Defaults to https://merchant.ordersail.com/signup when unset.
PUBLIC_MERCHANT_SIGNUP_URL=https://merchant.ordersail.com/signup
