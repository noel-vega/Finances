---
const features = [
	{ n: '01', title: 'Products & inventory', desc: 'Catalog, categories, brands, and stock tracked per location.' },
	{ n: '02', title: 'Orders & carts', desc: 'Every order and open cart — smooth sailing from click to delivery.' },
	{ n: '03', title: 'Ports', desc: 'One store or a chain — inventory stays correct at every port.' },
	{ n: '04', title: 'Customers', desc: 'Self-serve signup and sign-in for shoppers — their cart follows them in.' },
	{ n: '05', title: 'Crew', desc: 'Invite your crew by email to help run the shop.' },
	{ n: '06', title: 'Payments', desc: 'Stripe Connect. Payouts and refunds, handled.' },
	{ n: '07', title: 'Developer API', desc: 'Documented REST API. Build your own storefront.' },
];

const steps = [
	{ title: 'Create an account', desc: 'Free. No card required.' },
	{ title: 'Add products, connect Stripe', desc: 'Your catalog, your payouts.' },
	{ title: 'Share your storefront', desc: 'Set sail — start taking orders.' },
];

const year = new Date().getFullYear();
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="OrderSail — charting commerce for small business. Products, orders, inventory, and payouts."
		/>
		<title>OrderSail</title>
	</head>
	<body>
		<div class="wrap">
			<header class="top">
				<span class="mark">
					<svg class="mark-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
						<path d="M12 3v11" stroke-linecap="round" />
						<circle cx="12" cy="4.6" r="1.6" />
						<path d="M4 14c1.6 3.6 5 5.6 8 5.6s6.4-2 8-5.6" stroke-linecap="round" />
						<path d="M4 14l2.2 4.4M20 14l-2.2 4.4" stroke-linecap="round" />
					</svg>
					OrderSail
				</span>
				<nav class="nav">
					<a href="#index">Index</a>
					<a href="#route">Process</a>
				</nav>
				<a class="cta-top" href="#get-started">Sign up</a>
			</header>

			<section class="hero">
				<p class="eyebrow">Charting commerce for small business — Est. 2026</p>
				<h1>Set sail with your store.</h1>
				<p class="lede">
					Products, orders, inventory, and payouts — smooth sailing from cart
					to doorstep. No separate tools, no duct-taped integrations.
				</p>
				<div class="actions">
					<a class="btn-primary" href="#get-started">Sign up — free</a>
					<a class="btn-line" href="#index">View the index</a>
				</div>
			</section>

			<section class="problem" id="problem">
				<p class="eyebrow">Rough waters</p>
				<h2 class="problem-title">Running a store shouldn't feel like this.</h2>
				<div class="problem-grid">
					<div class="problem-item">
						<h3>Too many disconnected tools</h3>
						<p>Inventory in one app, orders in another, payments somewhere else — nothing talks to each other.</p>
					</div>
					<div class="problem-item">
						<h3>Inventory that doesn't reflect reality</h3>
						<p>A single stock number that drifts out of sync the moment you sell somewhere else.</p>
					</div>
					<div class="problem-item">
						<h3>Payouts you can't trace</h3>
						<p>Money moves, but connecting an order to what actually landed in your account takes a spreadsheet.</p>
					</div>
					<div class="problem-item">
						<h3>Shipping bolted on as an afterthought</h3>
						<p>Buying a label means leaving your order screen — and hoping the tracking number makes it back.</p>
					</div>
				</div>
				<div class="solution">
					<h2 class="solution-title">One deck. Everything in view.</h2>
					<p>
						OrderSail brings your catalog, inventory, orders, payments, and shipping into a
						single system. Real per-location stock with a full history, Stripe Connect payouts
						that go straight to you, and shipping labels purchased right from the order — so
						nothing drifts out of sync, and nothing gets lost overboard.
					</p>
				</div>
			</section>

			<hr class="rule" />

			<section class="index" id="index">
				<h2>Index</h2>
				<div class="list">
					{
						features.map((f) => (
							<div class="row">
								<span class="row-n">{f.n}</span>
								<h3>{f.title}</h3>
								<p>{f.desc}</p>
							</div>
						))
					}
				</div>
			</section>

			<section class="journey" id="journey">
				<p class="eyebrow">The customer's voyage</p>
				<h2>A smooth trip, every time.</h2>
				<div class="journey-list">
					<div class="jstep">
						<span class="jstep-dot"></span>
						<div class="jstep-body">
							<h4>Browse</h4>
							<p>Your storefront, fast and mobile-friendly — always in sync with real stock.</p>
						</div>
					</div>
					<div class="jstep">
						<span class="jstep-dot"></span>
						<div class="jstep-body">
							<h4>Add to cart</h4>
							<p>Guest or signed in — their cart follows them either way.</p>
						</div>
					</div>
					<div class="jstep">
						<span class="jstep-dot"></span>
						<div class="jstep-body">
							<h4>Checkout</h4>
							<p>Stripe-hosted checkout with live shipping rates, done in seconds.</p>
						</div>
					</div>
					<div class="jstep">
						<span class="jstep-dot"></span>
						<div class="jstep-body">
							<h4>Shipped</h4>
							<p>A label's purchased, and tracking goes out automatically.</p>
						</div>
					</div>
					<div class="jstep jstep-last">
						<span class="jstep-dot"></span>
						<div class="jstep-body">
							<h4>Delivered</h4>
							<p>Tracking updates land right on the order — no guessing where it is.</p>
						</div>
					</div>
				</div>
			</section>

			<hr class="rule" />

			<section class="route" id="route">
				<h2>Process</h2>
				<div class="route-list">
					{
						steps.map((s, i) => (
							<div class="rstep">
								<span class="rstep-n">{String(i + 1).padStart(2, '0')}</span>
								<div>
									<h4>{s.title}</h4>
									<p>{s.desc}</p>
								</div>
							</div>
						))
					}
				</div>
			</section>

			<section class="final" id="get-started">
				<h2>Set sail today.</h2>
				<p>Free while in beta. No credit card.</p>
				<a class="btn-primary" href="/signup">Create your account →</a>
			</section>

			<footer class="foot">
				<span>OrderSail</span>
				<span>&copy; {year}</span>
			</footer>
		</div>
	</body>
</html>

<style>
	:root {
		--bg: #f6f3ec;
		--ink: #14213d;
		--ink-dim: #5c6b7a;
		--line: #14213d;
	}

	:global(html) {
		background: var(--bg);
	}
	:global(body) {
		margin: 0;
		background: var(--bg);
		color: var(--ink);
		font-family: Georgia, 'Times New Roman', serif;
	}
	:global(a) {
		color: inherit;
	}
	:global(:focus-visible) {
		outline: 2px solid var(--ink);
		outline-offset: 3px;
	}

	.wrap {
		max-width: 980px;
		margin: 0 auto;
		padding: 0 28px;
	}

	.top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 30px 0;
		font-family: ui-monospace, monospace;
	}
	.mark {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-weight: 700;
		font-size: 1rem;
		letter-spacing: -0.01em;
	}
	.mark-icon {
		width: 15px;
		height: 15px;
		flex-shrink: 0;
	}
	.nav {
		display: flex;
		gap: 28px;
		font-size: 0.82rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}
	.nav a {
		text-decoration: none;
	}
	.nav a:hover {
		text-decoration: underline;
	}
	.cta-top {
		text-decoration: none;
		font-size: 0.82rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		border-bottom: 1px solid var(--line);
		padding-bottom: 2px;
	}

	.hero {
		padding: 40px 0 70px;
	}
	.eyebrow {
		font-family: ui-monospace, monospace;
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--ink-dim);
		margin: 0 0 26px;
	}
	.hero h1 {
		font-size: clamp(2.6rem, 7vw, 5.2rem);
		line-height: 1;
		font-weight: 400;
		letter-spacing: -0.02em;
		margin: 0 0 30px;
		max-width: 15ch;
	}
	.lede {
		font-family: system-ui, sans-serif;
		font-size: 1.15rem;
		line-height: 1.6;
		color: var(--ink-dim);
		max-width: 48ch;
		margin: 0 0 36px;
	}
	.actions {
		display: flex;
		gap: 24px;
		align-items: center;
		flex-wrap: wrap;
	}
	.btn-primary {
		text-decoration: none;
		font-family: ui-monospace, monospace;
		font-size: 0.86rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		padding: 15px 26px;
		background: var(--ink);
		color: var(--bg);
	}
	.btn-line {
		text-decoration: none;
		font-family: ui-monospace, monospace;
		font-size: 0.86rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		border-bottom: 1px solid var(--line);
		padding-bottom: 3px;
	}

	.rule {
		height: 1px;
		border: none;
		background-image: repeating-linear-gradient(
			to right,
			var(--line) 0,
			var(--line) 1px,
			transparent 1px,
			transparent 12px
		);
	}

	.problem {
		padding: 24px 0 70px;
	}
	.problem-title {
		font-family: Georgia, serif;
		font-weight: 400;
		font-size: clamp(1.6rem, 3.4vw, 2.2rem);
		letter-spacing: -0.01em;
		max-width: 24ch;
		margin: 0 0 44px;
	}
	.problem-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 36px 48px;
		margin: 0 0 56px;
	}
	.problem-item {
		padding-top: 20px;
		border-top: 1px solid color-mix(in srgb, var(--line) 20%, transparent);
	}
	.problem-item h3 {
		font-family: Georgia, serif;
		font-size: 1.1rem;
		font-weight: 400;
		margin: 0 0 8px;
	}
	.problem-item p {
		font-family: system-ui, sans-serif;
		font-size: 0.95rem;
		color: var(--ink-dim);
		line-height: 1.5;
		margin: 0;
	}
	.solution {
		padding-top: 32px;
		border-top: 1px solid var(--line);
	}
	.solution-title {
		font-family: Georgia, serif;
		font-weight: 400;
		font-size: clamp(1.8rem, 4vw, 2.4rem);
		letter-spacing: -0.01em;
		margin: 0 0 18px;
	}
	.solution p {
		font-family: system-ui, sans-serif;
		font-size: 1.05rem;
		line-height: 1.65;
		color: var(--ink-dim);
		max-width: 58ch;
		margin: 0;
	}

	.index {
		padding: 60px 0;
	}
	.index h2,
	.route h2,
	.final h2 {
		font-family: ui-monospace, monospace;
		font-size: 0.82rem;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		font-weight: 400;
		color: var(--ink-dim);
		margin: 0 0 40px;
	}
	.final h2 {
		font-size: clamp(2rem, 4vw, 2.8rem);
		color: var(--ink);
		letter-spacing: -0.01em;
		font-family: Georgia, serif;
	}
	.list {
		display: flex;
		flex-direction: column;
	}
	.row {
		display: grid;
		grid-template-columns: 60px 260px 1fr;
		align-items: baseline;
		gap: 20px;
		padding: 22px 0;
		border-top: 1px solid color-mix(in srgb, var(--line) 20%, transparent);
	}
	.row:last-child {
		border-bottom: 1px solid color-mix(in srgb, var(--line) 20%, transparent);
	}
	.row-n {
		font-family: ui-monospace, monospace;
		font-size: 0.85rem;
		color: var(--ink-dim);
	}
	.row h3 {
		font-size: 1.15rem;
		font-weight: 400;
		margin: 0;
	}
	.row p {
		font-family: system-ui, sans-serif;
		font-size: 0.95rem;
		color: var(--ink-dim);
		line-height: 1.5;
		margin: 0;
	}

	.route {
		padding: 60px 0;
	}
	.route-list {
		display: flex;
		flex-direction: column;
		gap: 30px;
	}
	.rstep {
		display: flex;
		gap: 26px;
	}
	.rstep-n {
		font-family: ui-monospace, monospace;
		font-size: 1.3rem;
		color: var(--ink-dim);
		flex-shrink: 0;
	}
	.rstep h4 {
		font-size: 1.15rem;
		font-weight: 400;
		margin: 0 0 6px;
	}
	.rstep p {
		font-family: system-ui, sans-serif;
		font-size: 0.95rem;
		color: var(--ink-dim);
		margin: 0;
	}

	.journey {
		padding: 60px 0;
	}
	.journey h2 {
		font-family: Georgia, serif;
		font-weight: 400;
		font-size: clamp(1.6rem, 3.4vw, 2.2rem);
		letter-spacing: -0.01em;
		margin: 0 0 44px;
	}
	.journey-list {
		display: flex;
		flex-direction: column;
	}
	.jstep {
		display: flex;
		gap: 22px;
		position: relative;
	}
	.jstep-dot {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--ink);
		flex-shrink: 0;
		margin-top: 7px;
	}
	.jstep:not(.jstep-last)::before {
		content: '';
		position: absolute;
		top: 22px;
		bottom: 0;
		left: 4px;
		width: 1px;
		background: color-mix(in srgb, var(--line) 35%, transparent);
	}
	.jstep-body {
		padding-bottom: 30px;
	}
	.jstep-last .jstep-body {
		padding-bottom: 0;
	}
	.jstep h4 {
		font-size: 1.1rem;
		font-weight: 400;
		margin: 0 0 6px;
	}
	.jstep p {
		font-family: system-ui, sans-serif;
		font-size: 0.95rem;
		color: var(--ink-dim);
		line-height: 1.5;
		margin: 0;
	}

	.final {
		padding: 90px 0;
		text-align: center;
	}
	.final p {
		font-family: system-ui, sans-serif;
		color: var(--ink-dim);
		margin: 0 0 32px;
	}

	.foot {
		display: flex;
		justify-content: space-between;
		padding: 26px 0 60px;
		border-top: 1px solid var(--line);
		font-family: ui-monospace, monospace;
		font-size: 0.8rem;
		color: var(--ink-dim);
	}

	@media (max-width: 720px) {
		.nav {
			display: none;
		}
		.row {
			grid-template-columns: 1fr;
			gap: 8px;
		}
		.problem-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
