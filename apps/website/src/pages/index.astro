---
const features = [
	{ n: '01', title: 'Products & inventory', desc: 'Catalog, categories, brands, and stock tracked per location.' },
	{ n: '02', title: 'Orders & carts', desc: 'Every order and open cart, in one view.' },
	{ n: '03', title: 'Multi-location', desc: 'One store or a chain — inventory stays correct.' },
	{ n: '04', title: 'Customers', desc: 'Self-serve signup and sign-in for shoppers — their cart follows them in.' },
	{ n: '05', title: 'Staff', desc: 'Invite your team by email to help run the shop.' },
	{ n: '06', title: 'Payments', desc: 'Stripe Connect. Payouts and refunds, handled.' },
	{ n: '07', title: 'Developer API', desc: 'Documented REST API. Build your own storefront.' },
];

const steps = [
	{ title: 'Create an account', desc: 'Free. No card required.' },
	{ title: 'Add products, connect Stripe', desc: 'Your catalog, your payouts.' },
	{ title: 'Share your storefront', desc: 'Start taking orders.' },
];

const year = new Date().getFullYear();
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Harbor — the back office for retailers. Products, orders, inventory, and payouts."
		/>
		<title>Harbor</title>
	</head>
	<body>
		<div class="wrap">
			<header class="top">
				<span class="mark">Harbor</span>
				<nav class="nav">
					<a href="#index">Index</a>
					<a href="#route">Process</a>
				</nav>
				<a class="cta-top" href="#get-started">Sign up</a>
			</header>

			<section class="hero">
				<p class="eyebrow">The back office for retail — Est. 2026</p>
				<h1>Run the whole store. From one place.</h1>
				<p class="lede">
					Products, orders, inventory, and payouts. No separate tools, no
					duct-taped integrations — just the systems a retailer actually needs.
				</p>
				<div class="actions">
					<a class="btn-primary" href="#get-started">Sign up — free</a>
					<a class="btn-line" href="#index">View the index</a>
				</div>
			</section>

			<hr class="rule" />

			<section class="index" id="index">
				<h2>Index</h2>
				<div class="list">
					{
						features.map((f) => (
							<div class="row">
								<span class="row-n">{f.n}</span>
								<h3>{f.title}</h3>
								<p>{f.desc}</p>
							</div>
						))
					}
				</div>
			</section>

			<hr class="rule" />

			<section class="route" id="route">
				<h2>Process</h2>
				<div class="route-list">
					{
						steps.map((s, i) => (
							<div class="rstep">
								<span class="rstep-n">{String(i + 1).padStart(2, '0')}</span>
								<div>
									<h4>{s.title}</h4>
									<p>{s.desc}</p>
								</div>
							</div>
						))
					}
				</div>
			</section>

			<section class="final" id="get-started">
				<h2>Start today.</h2>
				<p>Free while in beta. No credit card.</p>
				<a class="btn-primary" href="/signup">Create your account →</a>
			</section>

			<footer class="foot">
				<span>Harbor</span>
				<span>&copy; {year}</span>
			</footer>
		</div>
	</body>
</html>

<style>
	:root {
		--bg: #ffffff;
		--ink: #0a0a0a;
		--ink-dim: #6b6b6b;
		--line: #0a0a0a;
	}
	@media (prefers-color-scheme: dark) {
		:root:not([data-theme='light']) {
			--bg: #0a0a0a;
			--ink: #f5f5f5;
			--ink-dim: #9a9a9a;
			--line: #f5f5f5;
		}
	}
	:root[data-theme='dark'] {
		--bg: #0a0a0a;
		--ink: #f5f5f5;
		--ink-dim: #9a9a9a;
		--line: #f5f5f5;
	}

	:global(html) {
		background: var(--bg);
	}
	:global(body) {
		margin: 0;
		background: var(--bg);
		color: var(--ink);
		font-family: Georgia, 'Times New Roman', serif;
	}
	:global(a) {
		color: inherit;
	}
	:global(:focus-visible) {
		outline: 2px solid var(--ink);
		outline-offset: 3px;
	}

	.wrap {
		max-width: 980px;
		margin: 0 auto;
		padding: 0 28px;
	}

	.top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 30px 0;
		font-family: ui-monospace, monospace;
	}
	.mark {
		font-weight: 700;
		font-size: 1rem;
		letter-spacing: -0.01em;
	}
	.nav {
		display: flex;
		gap: 28px;
		font-size: 0.82rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
	.nav a {
		text-decoration: none;
	}
	.nav a:hover {
		text-decoration: underline;
	}
	.cta-top {
		text-decoration: none;
		font-size: 0.82rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		border-bottom: 1px solid var(--line);
		padding-bottom: 2px;
	}

	.hero {
		padding: 40px 0 70px;
	}
	.eyebrow {
		font-family: ui-monospace, monospace;
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--ink-dim);
		margin: 0 0 26px;
	}
	.hero h1 {
		font-size: clamp(2.6rem, 7vw, 5.2rem);
		line-height: 1;
		font-weight: 400;
		letter-spacing: -0.02em;
		margin: 0 0 30px;
		max-width: 15ch;
	}
	.lede {
		font-family: system-ui, sans-serif;
		font-size: 1.15rem;
		line-height: 1.6;
		color: var(--ink-dim);
		max-width: 48ch;
		margin: 0 0 36px;
	}
	.actions {
		display: flex;
		gap: 24px;
		align-items: center;
		flex-wrap: wrap;
	}
	.btn-primary {
		text-decoration: none;
		font-family: ui-monospace, monospace;
		font-size: 0.86rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		padding: 15px 26px;
		background: var(--ink);
		color: var(--bg);
	}
	.btn-line {
		text-decoration: none;
		font-family: ui-monospace, monospace;
		font-size: 0.86rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		border-bottom: 1px solid var(--line);
		padding-bottom: 3px;
	}

	.rule {
		border: none;
		border-top: 1px solid var(--line);
		margin: 0;
	}

	.index {
		padding: 60px 0;
	}
	.index h2,
	.route h2,
	.final h2 {
		font-family: ui-monospace, monospace;
		font-size: 0.82rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-weight: 400;
		color: var(--ink-dim);
		margin: 0 0 40px;
	}
	.final h2 {
		font-size: clamp(2rem, 4vw, 2.8rem);
		color: var(--ink);
		letter-spacing: -0.01em;
		font-family: Georgia, serif;
	}
	.list {
		display: flex;
		flex-direction: column;
	}
	.row {
		display: grid;
		grid-template-columns: 60px 260px 1fr;
		align-items: baseline;
		gap: 20px;
		padding: 22px 0;
		border-top: 1px solid color-mix(in srgb, var(--line) 20%, transparent);
	}
	.row:last-child {
		border-bottom: 1px solid color-mix(in srgb, var(--line) 20%, transparent);
	}
	.row-n {
		font-family: ui-monospace, monospace;
		font-size: 0.85rem;
		color: var(--ink-dim);
	}
	.row h3 {
		font-size: 1.15rem;
		font-weight: 400;
		margin: 0;
	}
	.row p {
		font-family: system-ui, sans-serif;
		font-size: 0.95rem;
		color: var(--ink-dim);
		line-height: 1.5;
		margin: 0;
	}

	.route {
		padding: 60px 0;
	}
	.route-list {
		display: flex;
		flex-direction: column;
		gap: 30px;
	}
	.rstep {
		display: flex;
		gap: 26px;
	}
	.rstep-n {
		font-family: ui-monospace, monospace;
		font-size: 1.3rem;
		color: var(--ink-dim);
		flex-shrink: 0;
	}
	.rstep h4 {
		font-size: 1.15rem;
		font-weight: 400;
		margin: 0 0 6px;
	}
	.rstep p {
		font-family: system-ui, sans-serif;
		font-size: 0.95rem;
		color: var(--ink-dim);
		margin: 0;
	}

	.final {
		padding: 90px 0;
		text-align: center;
	}
	.final p {
		font-family: system-ui, sans-serif;
		color: var(--ink-dim);
		margin: 0 0 32px;
	}

	.foot {
		display: flex;
		justify-content: space-between;
		padding: 26px 0 60px;
		border-top: 1px solid var(--line);
		font-family: ui-monospace, monospace;
		font-size: 0.8rem;
		color: var(--ink-dim);
	}

	@media (max-width: 720px) {
		.nav {
			display: none;
		}
		.row {
			grid-template-columns: 1fr;
			gap: 8px;
		}
	}
</style>
