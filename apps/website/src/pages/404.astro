---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found — OrderSail" description="That page isn't here.">
	<section class="notfound">
		<p class="eyebrow">Error 404</p>
		<h1>Off the map.</h1>
		<p class="lede">That page isn't here — it may have moved, or the link was wrong.</p>
		<nav class="links" aria-label="Recover">
			<a href="/">Home</a>
			<a href="/features">Features</a>
			<a href="/faq">FAQ</a>
		</nav>
	</section>
</Layout>

<style>
	.notfound {
		padding: 80px 0 120px;
	}
	.notfound h1 {
		font-family: Georgia, serif;
		font-size: clamp(2.4rem, 6vw, 4rem);
		line-height: 1.05;
		font-weight: 400;
		letter-spacing: -0.02em;
		margin: 0 0 20px;
	}
	.lede {
		font-family: system-ui, sans-serif;
		font-size: 1.08rem;
		line-height: 1.6;
		color: var(--ink-dim);
		max-width: 44ch;
		margin: 0 0 36px;
	}
	.links {
		display: flex;
		gap: 26px;
		flex-wrap: wrap;
		font-family: ui-monospace, monospace;
		font-size: 0.82rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}
	.links a {
		text-decoration: none;
		border-bottom: 1px solid var(--line);
		padding-bottom: 2px;
	}
</style>
