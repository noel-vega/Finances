---
import { signupUrl, signinUrl } from '../lib/urls';

const links = [
	{ href: '/features', label: 'Features' },
	{ href: '/pricing', label: 'Pricing' },
	{ href: '/how-it-works', label: 'How it works' },
	{ href: '/faq', label: 'FAQ' },
];

// Normalize away any trailing slash so `/features/` still matches `/features`.
const current = Astro.url.pathname.replace(/(.)\/$/, '$1');
---

<header class="top">
	<a class="mark" href="/">
		<svg class="mark-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
			<path d="M12 3v11" stroke-linecap="round"></path>
			<circle cx="12" cy="4.6" r="1.6"></circle>
			<path d="M4 14c1.6 3.6 5 5.6 8 5.6s6.4-2 8-5.6" stroke-linecap="round"></path>
			<path d="M4 14l2.2 4.4M20 14l-2.2 4.4" stroke-linecap="round"></path>
		</svg>
		OrderSail
	</a>

	<nav class="nav" aria-label="Primary">
		{
			links.map((l) => (
				<a href={l.href} aria-current={current === l.href ? 'page' : undefined}>
					{l.label}
				</a>
			))
		}
	</nav>

	<div class="top-actions">
		<a class="signin-top" href={signinUrl}>Sign in</a>
		<a class="cta-top" href={signupUrl}>Start selling</a>
	</div>
</header>

<style>
	.top {
		max-width: 980px;
		margin: 0 auto;
		padding: 18px 28px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-family: ui-monospace, monospace;
	}
	.mark {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-weight: 700;
		font-size: 1rem;
		letter-spacing: -0.01em;
		text-decoration: none;
	}
	.mark-icon {
		width: 15px;
		height: 15px;
		flex-shrink: 0;
	}
	.nav {
		display: flex;
		gap: 28px;
		font-size: 0.82rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}
	.nav a {
		text-decoration: none;
	}
	.nav a:hover {
		text-decoration: underline;
	}
	.nav a[aria-current='page'] {
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.top-actions {
		display: flex;
		align-items: center;
		gap: 22px;
	}
	.signin-top {
		text-decoration: none;
		font-size: 0.82rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--ink-dim);
	}
	.signin-top:hover {
		text-decoration: underline;
	}
	.cta-top {
		text-decoration: none;
		font-size: 0.82rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		border-bottom: 1px solid var(--line);
		padding-bottom: 2px;
	}

	/* Mobile menu is added in OS-286; until then the nav collapses to the CTA. */
	@media (max-width: 720px) {
		.nav {
			display: none;
		}
	}
</style>
