# Copy to .env. Vite only exposes VITE_-prefixed vars, and everything here
# ships in the client bundle — so only publishable / anon values belong here.

# storefront-api base URL
VITE_STOREFRONT_API_BASE_URL=http://localhost:3001

# Account-scoped storefront API key. `npm run seed -w seed` creates one and
# prints it as `Created storefront API key: sfk_...` — copy that here.
# (Or create one in merchant-web under Developers and paste it.)
VITE_STOREFRONT_APP_KEY=sfk_xxx

# Your Stripe test-mode *publishable* key (pk_test_...) — same platform key
# as merchant-web. Loaded via loadStripe(pk, { stripeAccount }) for the
# embedded checkout on /checkout.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
