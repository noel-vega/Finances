# Copy to .env. Vite only exposes VITE_-prefixed vars, and everything here
# ships in the client bundle — so only publishable / anon values belong here.

# merchant-api base URL
VITE_MERCHANT_API_BASE_URL=http://localhost:3000

# Your Stripe test-mode *publishable* key (pk_test_...) — safe for the
# client. Used by the embedded Stripe Connect onboarding components.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
