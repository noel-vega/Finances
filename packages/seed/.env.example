DATABASE_URL=postgres://postgres:postgres@localhost:5432/ordersail

# local MinIO (packages/storage) — used by scripts/seed.ts to upload sample
# product images; must match apps/merchant-api/.env's values
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ordersail-product-images
MINIO_PUBLIC_BASE_URL=http://localhost:9000/ordersail-product-images
