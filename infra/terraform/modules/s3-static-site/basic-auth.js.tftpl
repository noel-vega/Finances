// Rendered by Terraform (modules/s3-static-site). The one CloudFront Function on
// viewer-request for the default cache behavior — does, in order:
//   1. optional HTTP Basic gate      (basic_auth_credentials non-empty)
//   2. optional directory-index rewrite (directory_index = true):
//        /features  -> /features/index.html
//        /features/ -> /features/index.html
// The /api/* behavior is never associated with this function.
function handler(event) {
    var request = event.request;
%{ if basic_auth ~}

    var expected = ${allowed_tokens};
    var provided = request.headers.authorization && request.headers.authorization.value;
    if (!provided || expected.indexOf(provided) === -1) {
        return {
            statusCode: 401,
            statusDescription: "Unauthorized",
            headers: {
                "www-authenticate": { value: ${realm_header} },
                "cache-control": { value: "no-store" }
            }
        };
    }
%{ endif ~}
%{ if directory_index ~}

    var uri = request.uri;
    if (uri.endsWith("/")) {
        request.uri = uri + "index.html";
    } else if (!uri.includes(".")) {
        request.uri = uri + "/index.html";
    }
%{ endif ~}

    return request;
}
